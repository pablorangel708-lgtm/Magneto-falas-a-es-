-- ============================================================
-- SISTEMA DE ENVIO DE CHAT (detecção automática)
-- ============================================================
local canalGeral = nil
local eventoChatLegado = nil
local usarChatNovo = false

pcall(function()
	if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
		local canais = TextChatService:WaitForChild("TextChannels", 5)
		if canais then
			canalGeral = canais:WaitForChild("RBXGeneral", 5)
		end
		if canalGeral then
			usarChatNovo = true
		end
	end
end)

if not usarChatNovo then
	pcall(function()
		local eventosChat = ReplicatedStorage:WaitForChild("DefaultChatSystemChatEvents", 5)
		if eventosChat then
			eventoChatLegado = eventosChat:WaitForChild("SayMessageRequest", 5)
		end
	end)
end

local function enviarMensagemChat(mensagem)
	if usarChatNovo and canalGeral then
		local ok = pcall(function()
			canalGeral:SendAsync(mensagem)
		end)
		if ok then
			return
		end
	end
	if eventoChatLegado then
		pcall(function()
			eventoChatLegado:FireServer(mensagem, "All")
		end)
	end
end

-- ============================================================
-- SISTEMA DE PAUSA DE 3 SEGUNDOS ENTRE MENSAGENS
-- ============================================================
local TEMPO_ESPERA = 3
local podeEnviar = true

local function atualizarStatus(texto, cor)
	if statusLabel then
		statusLabel.Text = texto
		statusLabel.TextColor3 = cor
	end
end

local function tentarEnviar(mensagem)
	if not podeEnviar then
		return false
	end

	podeEnviar = false
	enviarMensagemChat(mensagem)

	task.spawn(function()
		local restante = TEMPO_ESPERA
		while restante > 0 do
			atualizarStatus("⏳ Aguarde " .. restante .. "s...", COR_PERIGO)
			task.wait(1)
			restante -= 1
		end
		podeEnviar = true
		atualizarStatus("✅ Pronto para enviar", COR_ACCENT)
	end)

	return true
end

-- ============================================================
-- SUBSTITUIÇÃO DO NOME DO PERSONAGEM
-- ============================================================
local function montarTexto(modelo, precisaNome)
	if not precisaNome then
		return modelo
	end

	local nome = ""
	if campoNomePersonagem then
		nome = campoNomePersonagem.Text
	end

	if nome == nil or nome:gsub("%s+", "") == "" then
		nome = "{NOME_DO_PERSONAGEM}"
	else
		nome = nome:gsub("%%", "%%%%")
	end

	return modelo:gsub("{NOME_DO_PERSONAGEM}", nome)
end

