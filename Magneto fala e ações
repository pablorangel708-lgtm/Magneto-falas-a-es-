-- ============================================================
-- FUNÇÃO DE ARRASTAR (mouse e toque)
-- ============================================================
local function tornarArrastavel(alvo, alcaArrasto)
	alcaArrasto = alcaArrasto or alvo
	local arrastando = false
	local entradaArrasto
	local entradaInicial
	local posicaoInicial
	local moveu = false

	local function atualizarPosicao(entrada)
		local delta = entrada.Position - entradaInicial
		if math.abs(delta.X) > 3 or math.abs(delta.Y) > 3 then
			moveu = true
		end
		alvo.Position = UDim2.new(
			posicaoInicial.X.Scale,
			posicaoInicial.X.Offset + delta.X,
			posicaoInicial.Y.Scale,
			posicaoInicial.Y.Offset + delta.Y
		)
	end

	alcaArrasto.InputBegan:Connect(function(entrada)
		if entrada.UserInputType == Enum.UserInputType.MouseButton1 or entrada.UserInputType == Enum.UserInputType.Touch then
			arrastando = true
			moveu = false
			entradaInicial = entrada.Position
			posicaoInicial = alvo.Position

			entrada.Changed:Connect(function()
				if entrada.UserInputState == Enum.UserInputState.End and arrastando then
					arrastando = false
				end
			end)
		end
	end)

	alcaArrasto.InputChanged:Connect(function(entrada)
		if entrada.UserInputType == Enum.UserInputType.MouseMovement or entrada.UserInputType == Enum.UserInputType.Touch then
			entradaArrasto = entrada
		end
	end)

	UserInputService.InputChanged:Connect(function(entrada)
		if arrastando and entrada == entradaArrasto then
			atualizarPosicao(entrada)
		end
	end)

	return function()
		return moveu
	end
end

-- ============================================================
-- ABRIR / FECHAR PAINEL
-- ============================================================
local painelAberto = false
local tamanhoFinalPainel = painel.Size

local function abrirPainel()
	painel.Visible = true
	painel.Size = UDim2.new(
		tamanhoFinalPainel.X.Scale * 0.85, 0,
		tamanhoFinalPainel.Y.Scale * 0.85, 0
	)
	local tween = TweenService:Create(
		painel,
		TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{ Size = tamanhoFinalPainel }
	)
	tween:Play()
	painelAberto = true
end

local function fecharPainel()
	local tween = TweenService:Create(
		painel,
		TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ Size = UDim2.new(
			tamanhoFinalPainel.X.Scale * 0.85, 0,
			tamanhoFinalPainel.Y.Scale * 0.85, 0
		) }
	)
	tween:Play()
	tween.Completed:Connect(function()
		if not painelAberto then
			painel.Visible = false
			painel.Size = tamanhoFinalPainel
		end
	end)
	painelAberto = false
end

local function alternarPainel()
	if painelAberto then
		fecharPainel()
	else
		abrirPainel()
	end
end

